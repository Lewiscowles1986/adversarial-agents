  "prompts": {
    "builder": "file://prompts/builder.md",
    "critic": "file://prompts/critic.md",
    "judge": "file://prompts/judge.md"
  },
  "hooks": {
    "pre_router": [
      {
        "command": "echo 'Preparing to route...'",
        "cwd": "."
      }
